{
  "name": "Transporter",
  "version": "1.0.0",
  "description": "Figma plugin to export and import variables",
  "main": "code.js",
  "scripts": {
    "build": "bun x webpack --mode=production",
    "dev": "WATCHPACK_POLLING=true bun x webpack --mode=development --watch",
    "dev:notify": "WATCHPACK_POLLING=true bun x webpack --mode=development --watch | while read line; do echo \"$line\"; osascript -e 'display notification \"Plugin rebuilt! Press Command+Option+P to reload\" with title \"Figma Plugin\"'; done",
    "lint": "bun x eslint --ext .ts,.tsx --ignore-pattern node_modules .",
    "lint:fix": "bun x eslint --ext .ts,.tsx --ignore-pattern node_modules --fix .",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "chroma-js": "^2.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "colorthief": "^2.4.0",
    "lucide-react": "^0.475.0",
    "react": "^18.2.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.2.0",
    "react-syntax-highlighter": "^15.6.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "1.82.0",
    "@types/chroma-js": "^3.1.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "autoprefixer": "^10.4.16",
    "css-loader": "^6.8.1",
    "eslint": "^8.54.0",
    "html-webpack-plugin": "^5.5.3",
    "postcss": "^8.4.31",
    "postcss-loader": "^7.3.3",
    "react-dev-utils": "^12.0.1",
    "style-loader": "^3.3.3",
    "tailwindcss": "^3.3.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^6.0.1"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:@figma/figma-plugins/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "root": true,
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "caughtErrorsIgnorePattern": "^_"
        }
      ]
    }
  }
}
